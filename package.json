    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "astronomy",
    "telescope",
    "indi",
    "ascom",
    "websocket",
    "solar-system-3d"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinlin49361128-stack/solar-system-3d-bridge.git"
  },
  "homepage": "https://github.com/kevinlin49361128-stack/solar-system-3d-bridge#readme",
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ]
}
